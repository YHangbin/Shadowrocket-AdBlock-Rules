# ========= 网易云音乐广告与非必要功能屏蔽 (精准修正版) =========

# 核心广告接口屏蔽
URL-REGEX,^https?://interface3\.music\.163\.com/eapi/ad/.*,REJECT
URL-REGEX,^https?://interface3\.music\.163\.com/eapi/delivery/.*,REJECT
URL-REGEX,^https?://interface3\.music\.163\.com/eapi/dai/.*,REJECT
URL-REGEX,^https?://interface3\.music\.163\.com/eapi/aio/.*,REJECT

# 应用内弹窗、浮窗、推广位屏蔽
URL-REGEX,^https?://interface3\.music\.163\.com/eapi/resource-exposure/pop-up/.*,REJECT
URL-REGEX,^https?://interface3\.music\.163\.com/eapi/event/floating/layer.*,REJECT
URL-REGEX,^https?://interface3\.music\.163\.com/eapi/link/position/show/resource.*,REJECT
URL-REGEX,^https?://interface3\.music\.163\.com/eapi/middle/clientcfg/config/v2/full/delivery,REJECT

# 信息流、横幅、场景广告屏蔽
URL-REGEX,^https?://interface3\.music\.163\.com/eapi/rtrs/.*,REJECT
URL-REGEX,^https?://interface3\.music\.163\.com/eapi/link/page/rcmd/.*,REJECT
URL-REGEX,^https?://interface3\.music\.163\.com/eapi/link/scene/show/resource,REJECT

# 开屏与视频广告素材CDN屏蔽 (多来源)
DOMAIN,iadmusicmatvideo.music.126.net,REJECT
DOMAIN,iadmat.nosdn.127.net,REJECT
DOMAIN,iadmatapk.nosdn.127.net,REJECT
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,ossgw.alicdn.com,REJECT
DOMAIN-SUFFIX,360buyimg.com,REJECT
# (修正) 下方规则过于宽泛，可能误伤首页图片，故禁用
# DOMAIN-SUFFIX,alibabausercontent.com,REJECT
DOMAIN-SUFFIX,miaozhen.com,REJECT

# P2P加速与第三方SDK屏蔽
DOMAIN-SUFFIX,qiezibenpao.com,REJECT
DOMAIN-SUFFIX,xinqiucc.com,REJECT
DOMAIN-SUFFIX,kuiniuca.com,REJECT
DOMAIN-SUFFIX,tianwenca.com,REJECT

# (重点) 屏蔽内嵌的腾讯系广告SDK
DOMAIN-SUFFIX,video.qq.com,REJECT
# (修正) 下方规则误伤微信公众号图片，故禁用
# DOMAIN-SUFFIX,qpic.cn,REJECT

# 日志、追踪与性能监控屏蔽
DOMAIN,clientlog3.music.163.com,REJECT
DOMAIN,clientlogsf.music.163.com,REJECT
DOMAIN,clientlogdep.music.163.com,REJECT
DOMAIN,netapm.music.163.com,REJECT
DOMAIN,udataresys-log.nie.netease.com,REJECT
DOMAIN,videocloud.cn-hangzhou.log.aliyuncs.com,REJECT
# (第三方追踪)
DOMAIN-SUFFIX,zhuanzfx.com,REJECT
DOMAIN-SUFFIX,laiqukankan.com,REJECT
DOMAIN-SUFFIX,321fenx.com,REJECT
DOMAIN,interface3.music.163.com.163jiasu.com,REJECT

# (可选) 屏蔽内嵌的直播功能
DOMAIN,api.look.163.com,REJECT

# ========= 网易云音乐规则结束 =========


# 屏蔽微信读书更新提示，需要配合 MIMT
URL-REGEX,^https://i\.weread\.qq\.com/feature,REJECT-200
URL-REGEX,^https://i\.weread\.qq\.com/mobileSync,REJECT-200

# ChatGPT 分流
RULE-SET,https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/rule/Shadowrocket/OpenAI/OpenAI.list,US

# 去除微信读书开屏更新提示
[MITM]
hostname = %APPEND% i.weread.qq.com,interface3.music.163.com
